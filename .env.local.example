NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 本番は SQUARE_ENVIRONMENT / NEXT_PUBLIC_SQUARE_ENVIRONMENT を production にし、
# 各値を Square Developer Dashboard の Production 認証情報に差し替える
# （Production App ID は sq0idp- 始まり）。NEXT_PUBLIC_* はビルド時に埋め込まれるため
# 変更後は必ず再デプロイが必要。
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=your-square-app-id
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron 保護用シークレット（openssl rand -hex 32 で生成）
CRON_SECRET=your-cron-secret

PAYPAY_CLIENT_ID=your-paypay-client-id
PAYPAY_CLIENT_SECRET=your-paypay-client-secret
PAYPAY_MERCHANT_ID=your-paypay-merchant-id
PAYPAY_PRODUCTION=false

# 個人情報暗号化キー (AES-256-GCM)
# openssl rand -hex 32 で生成してください
ENCRYPTION_KEY=your-64-character-hex-string-generated-by-openssl-rand-hex-32

# エラー監視（Sentry）。sentry.io でプロジェクトを作成しDSNを発行する。
# 未設定の場合はSDKが何もしない（安全にno-op）ため、導入は任意のタイミングでよい。
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# ビルド時のソースマップアップロード用（省略可。省略時はアップロードのみスキップされる）
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
